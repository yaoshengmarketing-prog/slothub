---
import { getCollection } from 'astro:content';
import { compareUrl, gamesIndexUrl, guideIndexUrl, providersIndexUrl, searchUrl, slotsUrl, toolsIndexUrl } from '../lib/urls';
const nav = [
  ['找遊戲', gamesIndexUrl(), false],
  ['玩法與資料', slotsUrl(), false],
  ['遊戲廠商', providersIndexUrl(), false],
  ['教學', guideIndexUrl(), false],
  ['工具', toolsIndexUrl(), true],
] as const;
const validCompareSlugs = (await getCollection('games')).filter((game) => game.data.status === 'published').map((game) => game.id);
---
<header class="site-header">
  <a class="brand" href="/" aria-label="Slot Hub 首頁"><span class="brand-mark">SH</span><span>SLOT HUB<small>GAME INDEX</small></span></a>
  <nav id="site-primary-nav" aria-label="主要導覽">{nav.map(([label,href,mobileOnly]) => <a class:list={{ 'mobile-nav-only': mobileOnly }} href={href}>{label}</a>)}</nav>
  <div class="header-actions">
    <a class="header-search" href={searchUrl()}>搜尋</a>
    <a class="header-compare" href={compareUrl()} data-valid-compare-slugs={validCompareSlugs.join(',')}>比較遊戲 <span data-compare-count>0</span></a>
    <button class="header-menu" type="button" aria-label="開啟主要導覽" aria-expanded="false" aria-controls="site-primary-nav" data-header-menu><span aria-hidden="true">☰</span></button>
  </div>
</header>
<script>
  import { COMPARE_STORAGE_KEY, compareStateUrl, readCompareQuery, readStoredCompare } from '../lib/core-flow-state.mjs';
  const menuButton = document.querySelector<HTMLButtonElement>('[data-header-menu]');
  const primaryNav = document.querySelector<HTMLElement>('#site-primary-nav');
  const setMenuOpen = (open: boolean) => {
    if (!menuButton || !primaryNav) return;
    menuButton.setAttribute('aria-expanded', String(open));
    menuButton.setAttribute('aria-label', open ? '關閉主要導覽' : '開啟主要導覽');
    primaryNav.classList.toggle('is-open', open);
  };
  menuButton?.addEventListener('click', () => setMenuOpen(menuButton.getAttribute('aria-expanded') !== 'true'));
  primaryNav?.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a')) setMenuOpen(false);
  });
  document.addEventListener('click', (event) => {
    if (menuButton?.getAttribute('aria-expanded') === 'true' && !(event.target as Element).closest('.site-header')) setMenuOpen(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || menuButton?.getAttribute('aria-expanded') !== 'true') return;
    setMenuOpen(false);
    menuButton.focus();
  });
  const paint = () => document.querySelectorAll<HTMLAnchorElement>('.header-compare').forEach((link) => {
    const valid = (link.dataset.validCompareSlugs || '').split(',').filter(Boolean);
    const query = location.pathname === '/compare/' ? readCompareQuery(location.search, valid) : { hasGames: false, slugs: [] };
    const selected = query.hasGames ? query.slugs : readStoredCompare(localStorage.getItem(COMPARE_STORAGE_KEY), valid);
    localStorage.setItem(COMPARE_STORAGE_KEY, JSON.stringify(selected));
    link.href = compareStateUrl(selected);
    const count = link.querySelector('[data-compare-count]');
    if (count) count.textContent = String(selected.length);
  });
  paint(); addEventListener('slothub:compare', paint); addEventListener('storage', paint);
</script>
