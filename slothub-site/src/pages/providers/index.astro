---
import {getCollection} from 'astro:content';import BaseLayout from '../../layouts/BaseLayout.astro';import {providerUrl} from '../../lib/urls';import {providerRoleLabels} from '../../lib/taxonomy';const providers=(await getCollection('providers')).filter(x=>x.data.status==='published');const games=await getCollection('games');
---
<BaseLayout title="遊戲廠商｜Slot Hub" description="瀏覽 Slot Hub 已整理的遊戲開發商及旗下遊戲資料。" canonicalPath="/providers/"><section class="page-hero shell"><p class="eyebrow">PROVIDER INDEX</p><h1>遊戲廠商</h1><p>廠商、發行商與聚合平台可具有多重角色；第一版公開四家 Seed Data。</p></section><section class="section shell provider-list">{providers.map(p=><a href={providerUrl(p.id)}>{p.data.logo?<span class="provider-logo"><img src={p.data.logo.src} alt={p.data.logo.alt} loading="lazy"/></span>:<span>{p.data.name.slice(0,2).toUpperCase()}</span>}<div><small>{p.data.roles.map(r=>providerRoleLabels[r]??r).join(' / ')}</small><h2>{p.data.name}</h2><p>{p.data.summary}</p></div><b>{games.filter(g=>g.data.provider===p.id).length} 款 →</b></a>)}</section></BaseLayout>
