---
import {getCollection} from 'astro:content';import BaseLayout from '../../layouts/BaseLayout.astro';import CompareWorkspace from '../../components/CompareWorkspace';import {gameUrl} from '../../lib/urls';const ps=await getCollection('providers');const names=new Map(ps.map(p=>[p.id,p.data.name]));const games=(await getCollection('games')).filter(x=>x.data.status==='published').map(g=>({slug:g.id,name:g.data.name,provider:g.data.provider,providerName:names.get(g.data.provider)??g.data.provider,primaryType:g.data.primaryType,subtypes:g.data.subtypes,summary:g.data.summary,rtp:g.data.rtp,volatility:g.data.volatility,reels:g.data.reels,paylines:g.data.paylines,bonusFeatures:g.data.bonusFeatures,editorialFeatured:g.data.editorialFeatured,url:gameUrl(g.id)}));
---
<BaseLayout title="遊戲比較｜Slot Hub" description="最多選擇三款遊戲，比較廠商、RTP、波動度與遊戲機制。" canonicalPath="/compare/" robots="noindex,follow"><section class="page-hero shell"><p class="eyebrow">COMPARE / MAX 3</p><h1>遊戲比較</h1><p>分享網址會保留選擇；無效或重複的遊戲代碼會自動忽略。</p></section><section class="section shell"><CompareWorkspace games={games} client:load/></section></BaseLayout>
