---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CompareWorkspace from '../../components/CompareWorkspace';
import { loadPublishedGameCatalog } from '../../lib/game-catalog';

const { games } = await loadPublishedGameCatalog();
---
<BaseLayout title="遊戲比較｜Slot Hub" description="最多選擇三款遊戲，比較廠商、RTP、波動度與遊戲機制。" canonicalPath="/compare/" robots="noindex,follow"><section class="page-hero shell"><p class="eyebrow">COMPARE / MAX 3</p><h1>遊戲比較</h1><p>分享網址會保留選擇；無效或重複的遊戲代碼會自動忽略。</p></section><section class="section shell compare-stage"><CompareWorkspace games={games} client:only="react"/></section></BaseLayout>
