---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CompareWorkspace from '../../components/CompareWorkspace';
import { loadPublishedGameCatalog } from '../../lib/game-catalog';
import { loadPublishedDataMethodologyEntry } from '../../lib/data-methodology';

const { games } = await loadPublishedGameCatalog();
const methodology = await loadPublishedDataMethodologyEntry();
---
<BaseLayout title="老虎機遊戲比較｜玩法、規格與 RTP 資料｜Slot Hub" description="最多選擇三款老虎機，並排查閱廠商、RTP、波動度、玩法、功能與已公布規格。各項資料保留來源，尚未取得的內容會明確標示。" canonicalPath="/compare/" robots="noindex,follow"><section class="page-hero shell"><p class="eyebrow">COMPARE / MAX 3</p><h1>比較已選遊戲的玩法與資料</h1><p>將已選遊戲放在一起，查看玩法、規格、功能與公布數據的差異。這裡不計算贏家、勝率或推薦排名；需要確認定義與版本時，可回到單款資料及來源紀錄。</p></section><section class="section shell compare-stage">{methodology && <p class="compare-methodology-entry"><a class="data-methodology-link" href={methodology.url} data-methodology-entry="compare">閱讀資料方法與可信度 →</a></p>}<noscript><div class="compare-noscript"><strong>比較工具需要 JavaScript</strong><p>開啟 JavaScript 後可恢復分享網址中的比較狀態；你仍可前往遊戲庫逐款查看已核實資料。</p><a class="button secondary" href="/games/">前往遊戲庫</a></div></noscript><p><small>分享網址會保留選擇；無效或重複的遊戲代碼會自動忽略。</small></p><CompareWorkspace games={games} client:only="react"/></section></BaseLayout>
