---
import {getCollection} from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; import GameExplorer from '../../components/GameExplorer'; import {gameUrl} from '../../lib/urls';
const ps=(await getCollection('providers')).filter(x=>x.data.status==='published');const names=new Map(ps.map(p=>[p.id,p.data.name]));
const games=(await getCollection('games')).filter(x=>x.data.status==='published').map(g=>({slug:g.id,name:g.data.displayNameZhHant??g.data.originalName??g.data.name,originalName:g.data.originalName??g.data.name,displayNameZhHant:g.data.displayNameZhHant,aliases:g.data.aliases,seriesId:g.data.seriesId,seriesNameZhHant:g.data.seriesNameZhHant,installment:g.data.installment,relatedGames:g.data.relatedGames,provider:g.data.provider,providerName:names.get(g.data.provider)??g.data.provider,primaryType:g.data.primaryType,subtypes:g.data.subtypes,summary:g.data.summary,image:g.data.image?{src:g.data.image.src,alt:g.data.image.alt}:undefined,rtp:g.data.rtp,volatility:g.data.volatility,reels:g.data.reels,paylines:g.data.paylines,bonusFeatures:g.data.bonusFeatures,editorialFeatured:g.data.editorialFeatured,url:gameUrl(g.id)}));
---
<BaseLayout title="遊戲庫｜Slot Hub" description="依廠商、類型、RTP 與波動度搜尋、篩選及比較遊戲。" canonicalPath="/games/"><section class="page-hero shell"><p class="eyebrow">GAME LIBRARY</p><h1>遊戲庫</h1><p>用資料找遊戲。所有未核對的欄位都會保留空白，不影響其他條件的探索。</p></section><section class="section shell"><GameExplorer games={games} client:load/></section></BaseLayout>
