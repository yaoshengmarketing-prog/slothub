---
import {getCollection} from 'astro:content';import BaseLayout from '../../layouts/BaseLayout.astro';import AddCompareButton from '../../components/AddCompareButton';import {gameUrl,providerUrl} from '../../lib/urls';
export async function getStaticPaths(){const games=(await getCollection('games')).filter(x=>x.data.status==='published');return games.map(entry=>({params:{slug:entry.id},props:{entry}}))}
const {entry}=Astro.props;const providers=await getCollection('providers');const provider=providers.find(p=>p.id===entry.data.provider);const all=await getCollection('games');
const game={slug:entry.id,name:entry.data.name,provider:entry.data.provider,providerName:provider?.data.name??entry.data.provider,primaryType:entry.data.primaryType,subtypes:entry.data.subtypes,summary:entry.data.summary,rtp:entry.data.rtp,volatility:entry.data.volatility,reels:entry.data.reels,paylines:entry.data.paylines,bonusFeatures:entry.data.bonusFeatures,editorialFeatured:entry.data.editorialFeatured,url:gameUrl(entry.id)};
---
<BaseLayout title={`${entry.data.name}｜遊戲資料｜Slot Hub`} description={entry.data.summary} canonicalPath={gameUrl(entry.id)}><article class="detail-page shell"><a class="back-link" href="/games/">← 返回遊戲庫</a><div class="detail-hero"><div class="detail-art"><span>{provider?.data.name}</span><b>{entry.data.name.slice(0,1)}</b></div><div><p class="eyebrow">GAME FILE / {entry.id}</p><h1>{entry.data.name}</h1><p>{entry.data.summary}</p><div class="action-row"><AddCompareButton game={game} allSlugs={all.map(g=>g.id)} client:load/><a class="button secondary" href="/compare/">前往比較頁</a></div></div></div><dl class="spec-grid"><div><dt>遊戲廠商</dt><dd><a href={providerUrl(entry.data.provider)}>{provider?.data.name}</a></dd></div><div><dt>RTP</dt><dd>{entry.data.rtp?`${entry.data.rtp}%`:'尚無資料'}</dd></div><div><dt>波動度</dt><dd>{entry.data.volatility??'尚無資料'}</dd></div><div><dt>盤面</dt><dd>{entry.data.reels??'尚無資料'}</dd></div><div><dt>Paylines / Ways</dt><dd>{entry.data.paylines??'尚無資料'}</dd></div><div><dt>最後核對</dt><dd>{entry.data.source.checkedAt.toISOString().slice(0,10)}</dd></div></dl><section class="detail-copy"><h2>Bonus features</h2><p>{entry.data.bonusFeatures.length?entry.data.bonusFeatures.join('、'):'目前尚無已核對資料。'}</p><h2>資料來源</h2><a href={entry.data.source.url} rel="nofollow">{entry.data.source.label} ↗</a></section></article></BaseLayout>
