---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AddCompareButton from '../../components/AddCompareButton';
import { absoluteUrl, gameUrl, gamesIndexUrl, providerUrl } from '../../lib/urls';
import { featureLabels, jackpotTypeLabels, primaryTypeLabels, volatilityLabels, winMechanismLabels } from '../../lib/taxonomy';
import { buildGameDetailKnowledgePresentation, loadGuideRelationshipIndex, relationshipLabel, type GameDetailFieldPlacement } from '../../lib/guide-relationship-catalog';
import { buildSimilarPlayPresentation } from '../../lib/similar-play.mjs';
import { buildGameDetailPresentation } from '../../lib/game-detail-presentation.mjs';
import { loadPublishedDataMethodologyEntry } from '../../lib/data-methodology';
import { projectGameEvidence } from '../../lib/game-metric-evidence.mjs';
import MetricEvidenceSummary from '../../components/MetricEvidenceSummary.astro';

export async function getStaticPaths() {
  const games = (await getCollection('games')).filter((game) => game.data.status === 'published');
  return games.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const providers = await getCollection('providers');
const gameEntries = await getCollection('games');
const allGames = gameEntries.filter((game) => game.data.status === 'published');
const provider = providers.find((item) => item.id === entry.data.provider);
const providerNames = new Map(providers.map((item) => [item.id, item.data.name]));
const relationshipIndex = await loadGuideRelationshipIndex();
const dataMethodology = await loadPublishedDataMethodologyEntry();
const knowledgePresentation = buildGameDetailKnowledgePresentation(
  relationshipIndex.gameToGuides[entry.id] ?? [],
  {
    hasPrimaryRtp: entry.data.rtp !== undefined,
    hasRtpVariants: entry.data.rtpVariants.length > 0,
    hasNormalizedVolatility: Boolean(entry.data.volatilityNormalized ?? entry.data.volatility),
    hasOriginalVolatility: Boolean(entry.data.volatilityOriginal),
    hasMaxWin: entry.data.maxWinMultiplier !== undefined,
  },
);
const displayName = entry.data.displayNameZhHant ?? entry.data.originalName ?? entry.data.name;
const originalName = entry.data.originalName ?? entry.data.name;
const normalizedVolatility = entry.data.volatilityNormalized ?? entry.data.volatility;
const presentation = buildGameDetailPresentation(entry.data);
const metricEvidence = projectGameEvidence(entry.id, entry.data.metricEvidenceIds);
const featureStatements = metricEvidence.filter((evidence) => evidence.metricKey === 'feature-statement');
const titleCharacters = Array.from(displayName);
const titlePrefix = titleCharacters.length > 4 ? titleCharacters.slice(0, -2).join('') : displayName;
const titleTail = titleCharacters.length > 4 ? titleCharacters.slice(-2).join('') : '';
const titleSizeClass = titleCharacters.length >= 16 ? 'is-very-long-title' : titleCharacters.length >= 10 ? 'is-long-title' : '';

const formatDate = (date: Date) => date.toISOString().slice(0, 10);
const formatMultiplier = (value: number) => `${value.toLocaleString('en-US')}×`;
const formatNumber = (value: number) => value.toLocaleString('zh-Hant-TW', { maximumFractionDigits: 8 });
const mechanism = presentation.operation.mechanism
  ? winMechanismLabels[presentation.operation.mechanism] ?? presentation.operation.mechanism
  : undefined;
const gridDisplay = presentation.full.reels
  ? presentation.full.reels.replace(/\s*[x×]\s*/i, ' × ')
  : presentation.full.rows ? `${presentation.full.rows} 列` : undefined;
const formatWinCount = (value: number | undefined, mechanismValue: string | undefined) => value
  ? mechanismValue === 'paylines'
    ? `${value.toLocaleString()} 條賠線`
    : mechanismValue === 'ways-to-win' || mechanismValue === 'megaways'
      ? `${value.toLocaleString()} 路`
      : value.toLocaleString()
  : undefined;
const winCountDisplay = formatWinCount(presentation.full.winCount, presentation.full.winMechanism);

const explicitRelated = entry.data.relatedGames
  .map((slug) => allGames.find((game) => game.id === slug))
  .filter(Boolean);
const sameSeries = entry.data.seriesId
  ? allGames.filter((game) => game.id !== entry.id && game.data.seriesId === entry.data.seriesId)
  : [];
const seriesGames = [...explicitRelated, ...sameSeries]
  .filter((game, index, games) => game && games.findIndex((item) => item?.id === game.id) === index);
const quickStats = [
  {
    label: '主要玩法',
    value: mechanism,
    note: mechanism
      ? [gridDisplay, winCountDisplay].filter(Boolean).join(' · ') || '依原廠與已核實資料標示。'
      : '未用盤面、主題或功能反推主要賠付機制。',
    guidePlacement: 'core-mechanism' as const,
  },
  {
    label: '主要 RTP',
    value: presentation.quick.rtp.value !== undefined ? `${presentation.quick.rtp.value}%` : undefined,
    badge: presentation.quick.rtp.additionalVariantCount > 0 ? '多版本' : undefined,
    note: presentation.quick.rtp.value !== undefined
      ? presentation.quick.rtp.additionalVariantCount > 0
        ? `另有 ${presentation.quick.rtp.additionalVariantCount} 個已收錄數值，需連同版本與來源閱讀。`
        : '目前保存一個已核實的主要顯示值。'
      : '不從其他版本、同系列或第三方摘要補猜。',
    guidePlacement: 'core-rtp' as const,
  },
  {
    label: '統一波動度',
    value: presentation.quick.volatility.value
      ? volatilityLabels[presentation.quick.volatility.value] ?? presentation.quick.volatility.value
      : undefined,
    note: presentation.quick.volatility.original
      ? `原廠標示：${presentation.quick.volatility.original}`
      : '不由 RTP、題材或短期試玩結果推測。',
    guidePlacement: 'core-volatility' as const,
  },
  {
    label: '最高倍數',
    value: presentation.quick.maxWin.value !== undefined ? formatMultiplier(presentation.quick.maxWin.value) : undefined,
    note: presentation.quick.maxWin.value !== undefined
      ? '需連同原廠基準、範圍與成立條件閱讀。'
      : '不以單一符號或 Feature 的局部倍數替代整局上限。',
    guidePlacement: 'core-max-win' as const,
  },
] as { label: string; value?: string; badge?: string; note: string; guidePlacement: GameDetailFieldPlacement }[];

const unknown = '尚未核實';
const demo = entry.data.demo;
const isPlatformGamePage = demo?.accessType === 'platform-game-page';
const demoAccessLabel = demo?.accessType === 'direct-demo'
  ? '官方 Demo 頁'
  : demo?.accessType === 'official-game-page'
    ? '官方遊戲頁（含 Demo 入口）'
    : demo?.accessType === 'platform-game-page'
      ? '外部平台同款遊戲頁'
      : undefined;
const demoDisplay = demo?.status === 'available'
  ? isPlatformGamePage ? '已核實同款平台頁' : '已核實官方入口'
  : demo?.status === 'login-required'
    ? '需登入廠商頁面'
    : demo?.status === 'access-restricted'
      ? '目前無法公開存取'
      : '尚未核實精確入口';
const demoNote = demo?.status === 'available'
  ? `${demoAccessLabel}；核對 ${formatDate(demo.checkedAt)}。`
  : demo
    ? `核對 ${formatDate(demo.checkedAt)}；找不到精確入口不代表遊戲沒有 Demo。`
    : '尚未完成 Demo 覆蓋核對。';
const betRange = presentation.full.minBet !== undefined || presentation.full.maxBet !== undefined
  ? `${presentation.full.minBet !== undefined ? formatNumber(presentation.full.minBet) : unknown} ～ ${presentation.full.maxBet !== undefined ? formatNumber(presentation.full.maxBet) : unknown}`
  : undefined;
const fullSpecs = [
  { label: '原廠波動度', value: presentation.full.volatilityOriginal, guidePlacement: 'full-volatility' as const },
  { label: 'Slot Hub 統一波動度', value: presentation.full.volatilityNormalized ? volatilityLabels[presentation.full.volatilityNormalized] ?? presentation.full.volatilityNormalized : undefined, note: presentation.full.volatilityNormalized ? '編輯統一顯示，不是產業共同量表。' : undefined },
  { label: '盤面', value: gridDisplay },
  { label: '原廠賠付說明', value: presentation.full.originalWinDescription ?? winCountDisplay },
  { label: '最高倍數原文', value: presentation.full.maxWinOriginal ?? (presentation.full.maxWinMultiplier !== undefined ? formatMultiplier(presentation.full.maxWinMultiplier) : undefined) },
  { label: 'Bonus Buy', value: presentation.full.bonusBuy === undefined ? undefined : presentation.full.bonusBuy ? '支援' : '不支援', note: presentation.full.bonusBuy === undefined ? '缺值不等於不支援。' : undefined },
  { label: 'Jackpot 類型', value: presentation.full.jackpotType ? jackpotTypeLabels[presentation.full.jackpotType] ?? presentation.full.jackpotType : undefined },
  { label: '投注範圍', value: betRange },
  { label: '發行日期', value: presentation.full.releaseDate ? formatDate(presentation.full.releaseDate) : undefined },
  { label: 'Game ID', value: presentation.full.gameId },
  { label: '試玩／遊戲入口', value: demoDisplay, note: demoNote },
] as { label: string; value?: string; note?: string; guidePlacement?: GameDetailFieldPlacement }[];

const featureGuideDirect = knowledgePresentation.featureGuides.direct;
const featureGuideOverflow = knowledgePresentation.featureGuides.overflow;
const similarPlay = buildSimilarPlayPresentation(entry.id, gameEntries.map((item) => ({
  slug: item.id,
  status: item.data.status,
  name: item.data.displayNameZhHant ?? item.data.originalName ?? item.data.name,
  providerName: providerNames.get(item.data.provider) ?? item.data.provider,
  image: item.data.image ? { src: item.data.image.src, alt: item.data.image.alt } : undefined,
  winMechanism: item.data.winMechanism,
  winCount: item.data.winCount,
  features: item.data.features,
})));
const similarMechanismLabel = similarPlay.mechanism ? winMechanismLabels[similarPlay.mechanism] ?? similarPlay.mechanism : undefined;
const similarExploreUrl = similarPlay.mechanism ? gamesIndexUrl({ mechanism: similarPlay.mechanism }) : undefined;
const similarReasonLabel = (reason: { type: string; value: string | number }) => reason.type === 'win-count'
  ? entry.data.winMechanism === 'paylines'
    ? `同為 ${Number(reason.value).toLocaleString()} 條賠線`
    : `同為 ${Number(reason.value).toLocaleString()} 路`
  : featureLabels[String(reason.value)] ?? String(reason.value);

const sources = entry.data.sources.length ? entry.data.sources : [entry.data.source];
const game = {
  slug: entry.id, name: displayName, originalName, displayNameZhHant: entry.data.displayNameZhHant,
  aliases: entry.data.aliases, seriesId: entry.data.seriesId, seriesNameZhHant: entry.data.seriesNameZhHant,
  installment: entry.data.installment, relatedGames: entry.data.relatedGames, provider: entry.data.provider,
  providerName: provider?.data.name ?? entry.data.provider, primaryType: entry.data.primaryType,
  subtypes: entry.data.subtypes, summary: entry.data.summary,
  image: entry.data.image ? { src: entry.data.image.src, alt: entry.data.image.alt } : undefined,
  rtp: entry.data.rtp, rtpVariants: entry.data.rtpVariants, volatility: normalizedVolatility,
  maxWinMultiplier: entry.data.maxWinMultiplier, winMechanism: entry.data.winMechanism,
  reels: entry.data.reels, paylines: entry.data.paylines, bonusFeatures: entry.data.bonusFeatures,
  editorialFeatured: entry.data.editorialFeatured, url: gameUrl(entry.id),
};
const schema = {
  '@context': 'https://schema.org', '@type': 'VideoGame', name: displayName,
  alternateName: displayName !== originalName ? originalName : undefined,
  description: entry.data.summary, url: absoluteUrl(gameUrl(entry.id)),
  image: entry.data.image ? absoluteUrl(entry.data.image.src) : undefined,
  publisher: provider ? { '@type': 'Organization', name: provider.data.name, url: provider.data.officialUrl } : undefined,
  gamePlatform: 'Web', inLanguage: 'zh-Hant-TW',
  datePublished: entry.data.releaseDate ? formatDate(entry.data.releaseDate) : undefined,
  dateModified: formatDate(entry.data.updatedAt),
};
---

<BaseLayout title={`${displayName}｜遊戲資料｜Slot Hub`} description={entry.data.summary} canonicalPath={gameUrl(entry.id)} schema={schema}>
  <article class="game-file-page shell">
    <a class="back-link game-file-back" href="/games/">前往遊戲庫 →</a>

    <header class="game-file-hero">
      <figure class="game-file-art">
        {entry.data.image ? <img src={entry.data.image.src} alt={entry.data.image.alt} /> : <div aria-hidden="true">{displayName.slice(0, 1)}</div>}
        <figcaption>{primaryTypeLabels[entry.data.primaryType] ?? entry.data.primaryType}</figcaption>
      </figure>
      <div class="game-file-identity">
        <p class="eyebrow">GAME FILE / {entry.id}</p>
        <h1 class={titleSizeClass}>{titlePrefix}{titleTail && <span class="game-title-tail">{titleTail}</span>}</h1>
        {entry.data.displayNameZhHant && <p class="game-file-original">{originalName}</p>}
        <div class="game-file-meta">
          {provider && <>
            <a class="game-provider-hub-link" href={providerUrl(entry.data.provider)}>廠商資料：{provider.data.name}</a>
            <a
              class="game-provider-official-link"
              href={provider.data.officialUrl}
              target="_blank"
              rel="nofollow noopener noreferrer"
              aria-label={`前往 ${provider.data.name} 官方網站（新分頁）`}
            >廠商官網 ↗</a>
          </>}
          {entry.data.seriesNameZhHant && <span>{entry.data.seriesNameZhHant}{entry.data.installment ? ` · 第 ${entry.data.installment} 代` : ''}</span>}
          {entry.data.lastVerifiedAt && <span>最後核對 {formatDate(entry.data.lastVerifiedAt)}</span>}
        </div>
        <p class="game-file-summary">{entry.data.summary}</p>
        <div class="action-row">
          <AddCompareButton game={game} allSlugs={allGames.map((item) => item.id)} client:load />
          <a class="button secondary" href="/compare/">查看比較頁</a>
        </div>
      </div>
    </header>

    <section class="game-quick-read" aria-labelledby="quick-read-title">
      <div class="game-quick-heading"><p class="eyebrow">AT A GLANCE</p><h2 id="quick-read-title">快速看懂</h2></div>
      <dl>{quickStats.map((stat) => <div><dt>{stat.label}</dt><dd class={!stat.value ? 'is-unknown' : undefined}>{stat.value ?? unknown}{stat.badge && <small>{stat.badge}</small>}</dd><p>{stat.note}</p>{stat.value && knowledgePresentation.fieldGuides[stat.guidePlacement]?.map((match) => <a class="game-field-guide-link" href={match.guide.url} aria-label={`了解${stat.label}：${match.guide.title}`} data-guide-slug={match.guide.slug} data-guide-placement={stat.guidePlacement}>了解這項資料 →</a>)}</div>)}</dl>
    </section>

    {demo?.status === 'available' && demo.url && <section class="game-demo-access" aria-labelledby="game-access-title">
      <div class="game-demo-copy">
        <p class="eyebrow">{isPlatformGamePage ? 'EXTERNAL GAME PAGE' : 'OFFICIAL DEMO'}</p>
        <h2 id="game-access-title">{isPlatformGamePage ? '同款遊戲平台頁' : '官方 Demo'}</h2>
        <p>{isPlatformGamePage
          ? `已核對 ${demo.platformName} 上的同款 ${displayName} 遊戲頁；此頁不是 ${provider?.data.name ?? entry.data.provider} 官網，將在新分頁開啟。`
          : demo.accessType === 'direct-demo'
          ? `由 ${provider?.data.name ?? entry.data.provider} 提供的官方 Demo 頁，將在新分頁開啟。`
          : `由 ${provider?.data.name ?? entry.data.provider} 提供的官方遊戲頁，頁面內含 Demo 或測試入口。`}</p>
        <dl>
          <div><dt>入口類型</dt><dd>{demoAccessLabel}</dd></div>
          <div><dt>最後核對</dt><dd>{formatDate(demo.checkedAt)}</dd></div>
        </dl>
      </div>
      <div class="game-demo-external">
        <span>{isPlatformGamePage ? '已核實的同款平台入口' : '已核實的官方來源'}</span>
        <strong>{displayName}</strong>
        <p>{isPlatformGamePage
          ? '連結會前往第三方平台上的同款遊戲頁；是否提供免費 Demo、是否需登入及可用地區，以該平台實際顯示為準。'
          : demo.accessType === 'direct-demo'
          ? '連結會前往廠商維運的正式 Demo 頁；實際可用範圍仍依廠商設定。'
          : '連結會前往廠商的正式遊戲頁，再由頁面內的 Demo 或測試入口繼續。'}</p>
        <a class="button primary" href={demo.url} target="_blank" rel="nofollow noopener noreferrer">
          {isPlatformGamePage ? '前往平台遊戲頁 ↗' : demo.accessType === 'direct-demo' ? '前往官方 Demo 頁 ↗' : '前往官方遊戲頁 ↗'}
        </a>
      </div>
    </section>}

    <section class="game-operation" aria-labelledby="operation-title">
      <div class="game-section-heading"><p class="eyebrow">HOW IT WORKS</p><div><h2 id="operation-title">這款怎麼運作</h2><p>先看一般得獎如何成立，再把盤面流程與各項功能分開閱讀。</p></div></div>
      <div class="game-operation-band">
        <section aria-labelledby="mechanism-title">
          <p class="eyebrow">主要賠付機制</p>
          <h3 id="mechanism-title">{mechanism ?? unknown}</h3>
          {presentation.operation.originalWinDescription && <p>{presentation.operation.originalWinDescription}</p>}
          {(gridDisplay || winCountDisplay) && <dl><div><dt>盤面</dt><dd>{gridDisplay ?? unknown}</dd></div><div><dt>賠線／Ways</dt><dd>{winCountDisplay ?? unknown}</dd></div></dl>}
        </section>
        <section aria-labelledby="features-title">
          <p class="eyebrow">已確認功能</p>
          <h3 id="features-title">功能各有自己的規則</h3>
          {presentation.operation.features.length > 0
            ? <ul class="game-operation-features">{presentation.operation.features.map((feature: string) => <li>{featureLabels[feature] ?? feature}</li>)}</ul>
            : <p class="game-operation-unknown">目前尚未核實可列出的功能標籤。</p>}
          {presentation.operation.ruleNotes.length > 0 && <details class="game-rule-notes"><summary>查看已記錄的功能規則（{presentation.operation.ruleNotes.length}）</summary><ul>{presentation.operation.ruleNotes.map((note: string) => <li>{note}</li>)}</ul></details>}
        </section>
      </div>
      {featureStatements.length > 0 && <div class="game-feature-statements" aria-label="來源公布的功能差異">
        {featureStatements.map((evidence) => <section data-feature-group={evidence.groupId}>
          <h3>{evidence.label}</h3>
          <p>{evidence.value}</p>
          <p class="feature-limitation">{evidence.limitation}</p>
          <MetricEvidenceSummary evidence={evidence} />
        </section>)}
      </div>}
    </section>

    <section class="game-data-section" aria-labelledby="full-data-title">
      <div class="game-section-heading"><p class="eyebrow">STRUCTURED DATA</p><div><h2 id="full-data-title">完整資料與版本</h2><p>保留原廠文字、已收錄版本與缺值；缺值一律表示目前尚未核實。</p></div></div>
      <dl class="game-data-ledger">
        <div>
          <dt>Slot Hub 已收錄的 RTP 版本</dt>
          <dd class={presentation.full.rtpValues.length === 0 ? 'is-unknown' : undefined}>
            {presentation.full.rtpValues.length > 1
              ? <details><summary>查看 {presentation.full.rtpValues.length} 個已收錄數值</summary><p>{presentation.full.rtpValues.map((value: number) => `${value}%`).join('、')}</p><small>不同數值不代表每個市場都可自由選擇。</small></details>
              : presentation.full.rtpValues.length === 1 ? `${presentation.full.rtpValues[0]}%` : unknown}
          </dd>
          {knowledgePresentation.fieldGuides['full-rtp-variants']?.map((match) => <a class="game-field-guide-link" href={match.guide.url} aria-label={`了解 RTP 版本：${match.guide.title}`} data-guide-slug={match.guide.slug} data-guide-placement="full-rtp-variants">了解這項資料 →</a>)}
        </div>
        {fullSpecs.map((spec) => <div><dt>{spec.label}</dt><dd class={!spec.value ? 'is-unknown' : undefined}>{spec.value ?? unknown}{spec.note && <small>{spec.note}</small>}</dd>{spec.guidePlacement && knowledgePresentation.fieldGuides[spec.guidePlacement]?.map((match) => <a class="game-field-guide-link" href={match.guide.url} aria-label={`了解${spec.label}：${match.guide.title}`} data-guide-slug={match.guide.slug} data-guide-placement={spec.guidePlacement}>了解這項資料 →</a>)}</div>)}
      </dl>
    </section>

    {(seriesGames.length > 0 || similarPlay.items.length > 0 || provider || similarExploreUrl) && <section class="game-next-explore" aria-labelledby="next-explore-title">
      <div class="game-section-heading"><p class="eyebrow">NEXT</p><div><h2 id="next-explore-title">接著探索</h2><p>從已確認的系列、主要玩法、玩法相近或遊戲廠商繼續找。</p></div></div>

      {seriesGames.length > 0 && <div class="game-explore-group"><h3>同系列遊戲</h3><div class="related-game-grid">
        {seriesGames.map((item) => item && <a href={gameUrl(item.id)}>{item.data.image && <img src={item.data.image.src} alt="" loading="lazy" />}<span><strong>{item.data.displayNameZhHant ?? item.data.originalName ?? item.data.name}</strong>{item.data.displayNameZhHant && <small>{item.data.originalName ?? item.data.name}</small>}</span>{item.data.installment && <b>第 {item.data.installment} 代</b>}</a>)}
      </div></div>}

      {similarPlay.items.length > 0 && similarMechanismLabel && <div class="game-similar-play" aria-labelledby="similar-play-title">
        <div class="similar-play-subheading"><h3 id="similar-play-title">玩法相近</h3><p>依主要賠付機制整理，功能與規則可能不同。</p></div>
        <ul class="similar-play-grid">
          {similarPlay.items.map(({ game: item, reasons }) => <li><a href={gameUrl(item.slug)} data-similar-play-slug={item.slug}>
            {item.image ? <img src={item.image.src} alt="" loading="lazy" /> : <span class="similar-play-placeholder" aria-hidden="true">{item.name.slice(0, 1)}</span>}
            <span class="similar-play-card-body">
              <span class="similar-play-identity"><strong>{item.name}</strong><small>{item.providerName}</small></span>
              <span class="similar-play-reasons"><b>{similarMechanismLabel}</b>{reasons.map((reason: { type: string; value: string | number }) => <small>{similarReasonLabel(reason)}</small>)}</span>
            </span>
          </a></li>)}
        </ul>
      </div>}

      <nav class="game-explore-actions" aria-label="更多遊戲探索方式">
        {similarExploreUrl && similarMechanismLabel && <a class="button secondary" href={similarExploreUrl}>探索更多 {similarMechanismLabel} 遊戲</a>}
        {provider && <a class="button secondary" href={providerUrl(entry.data.provider)}>查看 {provider.data.name} 收錄遊戲</a>}
      </nav>
    </section>}

    {featureGuideDirect.length > 0 && <section class="game-guide-rail" aria-labelledby="game-guide-title">
      <div><p class="eyebrow">RELATED GUIDES</p><h2 id="game-guide-title">看懂相關概念</h2><p>依這款遊戲已確認的資料與功能，前往對應教學。</p></div>
      <div class="game-guide-list">
        <nav aria-label="相關遊戲功能教學">{featureGuideDirect.map((match) => <a href={match.guide.url} data-guide-slug={match.guide.slug} data-guide-placement="feature-direct"><span>{match.displayReasons.map((reason) => relationshipLabel(reason.type, reason.value)).join('、')}</span><strong>{match.guide.title}</strong><b>閱讀 →</b></a>)}</nav>
        {featureGuideOverflow.length > 0 && <details class="game-guide-overflow"><summary>查看更多相關教學（{featureGuideOverflow.length}）</summary><nav aria-label="更多相關遊戲功能教學">{featureGuideOverflow.map((match) => <a href={match.guide.url} data-guide-slug={match.guide.slug} data-guide-placement="feature-overflow"><span>{match.displayReasons.map((reason) => relationshipLabel(reason.type, reason.value)).join('、')}</span><strong>{match.guide.title}</strong><b>閱讀 →</b></a>)}</nav></details>}
      </div>
    </section>}

    {(sources.length > 0 || entry.data.lastVerifiedAt || entry.data.image) && <section class="game-sources" aria-labelledby="source-title">
      <div><p class="eyebrow">SOURCES & TRUST</p><h2 id="source-title">資料來源與可信度</h2>{entry.data.lastVerifiedAt && <p>最後核對日期 <strong>{formatDate(entry.data.lastVerifiedAt)}</strong></p>}{dataMethodology && <a class="data-methodology-link" href={dataMethodology.url} data-methodology-entry="game-detail">了解 Slot Hub 如何整理資料 →</a>}</div>
      <ul>
        {metricEvidence.map((evidence) => <li><MetricEvidenceSummary evidence={evidence} record /></li>)}
        {sources.map((source) => <li><a href={source.url} rel="nofollow">{source.label} ↗</a><small>核對 {formatDate(source.checkedAt)}</small></li>)}
        {entry.data.image && <li><a href={entry.data.image.sourceUrl} rel="nofollow">圖片來源 ↗</a><small>取得 {formatDate(entry.data.image.retrievedAt)}</small></li>}
        {demo?.status === 'available' && demo.url && <li><a href={demo.url} target="_blank" rel="nofollow noopener noreferrer">{isPlatformGamePage ? `${demo.platformName} 同款遊戲頁 ↗` : '官方 Demo／測試頁 ↗'}</a><small>核對 {formatDate(demo.checkedAt)}</small></li>}
      </ul>
    </section>}
  </article>
</BaseLayout>

<script>
  const revealEvidence = () => {
    const id = location.hash.slice(1);
    if (!id.startsWith('evidence-')) return;
    const record = document.getElementById(id);
    if (record instanceof HTMLDetailsElement) {
      record.open = true;
      requestAnimationFrame(() => record.scrollIntoView({ block: 'start' }));
    }
  };
  revealEvidence();
  addEventListener('hashchange', revealEvidence);
</script>

<style is:global>
  .game-feature-statements{display:grid;gap:24px;margin-top:28px}
  .game-feature-statements section{min-width:0;padding-top:22px;border-top:1px solid var(--navy);scroll-margin-top:100px}
  .game-feature-statements h3{margin:0;font-size:1.05rem}
  .game-feature-statements p{max-width:75ch;line-height:1.7;overflow-wrap:anywhere}
  .feature-limitation{font-size:.85rem;color:var(--muted)}
</style>
