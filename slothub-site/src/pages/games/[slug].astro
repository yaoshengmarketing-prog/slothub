---
import {getCollection} from 'astro:content';import BaseLayout from '../../layouts/BaseLayout.astro';import AddCompareButton from '../../components/AddCompareButton';import {gameUrl,providerUrl} from '../../lib/urls';import {volatilityLabels,primaryTypeLabels,subtypeLabels} from '../../lib/taxonomy';
export async function getStaticPaths(){const games=(await getCollection('games')).filter(x=>x.data.status==='published');return games.map(entry=>({params:{slug:entry.id},props:{entry}}))}
const {entry}=Astro.props;const providers=await getCollection('providers');const provider=providers.find(p=>p.id===entry.data.provider);const all=await getCollection('games');const displayName=entry.data.displayNameZhHant??entry.data.originalName??entry.data.name;const originalName=entry.data.originalName??entry.data.name;const related=entry.data.relatedGames.map(slug=>all.find(game=>game.id===slug)).filter(Boolean);
const game={slug:entry.id,name:displayName,originalName,displayNameZhHant:entry.data.displayNameZhHant,aliases:entry.data.aliases,seriesId:entry.data.seriesId,seriesNameZhHant:entry.data.seriesNameZhHant,installment:entry.data.installment,relatedGames:entry.data.relatedGames,provider:entry.data.provider,providerName:provider?.data.name??entry.data.provider,primaryType:entry.data.primaryType,subtypes:entry.data.subtypes,summary:entry.data.summary,image:entry.data.image?{src:entry.data.image.src,alt:entry.data.image.alt}:undefined,rtp:entry.data.rtp,volatility:entry.data.volatility,reels:entry.data.reels,paylines:entry.data.paylines,bonusFeatures:entry.data.bonusFeatures,editorialFeatured:entry.data.editorialFeatured,url:gameUrl(entry.id)};
---
<BaseLayout title={`${displayName}｜遊戲資料｜Slot Hub`} description={entry.data.summary} canonicalPath={gameUrl(entry.id)}><article class="detail-page shell"><a class="back-link" href="/games/">← 返回遊戲庫</a><div class="detail-hero"><div class="detail-art">{entry.data.image?<img src={entry.data.image.src} alt={entry.data.image.alt}/>:<b>{displayName.slice(0,1)}</b>}<span>{provider?.data.name}</span></div><div><p class="eyebrow">GAME FILE / {entry.id}</p><h1>{displayName}</h1>{entry.data.displayNameZhHant&&<p class="original-game-name">{originalName}</p>}{entry.data.seriesNameZhHant&&<p class="series-line">{entry.data.seriesNameZhHant}{entry.data.installment?` · 第 ${entry.data.installment} 代`:''}</p>}<p>{entry.data.summary}</p><div class="action-row"><AddCompareButton game={game} allSlugs={all.map(g=>g.id)} client:load/><a class="button secondary" href="/compare/">前往比較頁</a></div></div></div><dl class="spec-grid"><div><dt>遊戲廠商</dt><dd><a href={providerUrl(entry.data.provider)}>{provider?.data.name}</a></dd></div><div><dt>主類型</dt><dd>{primaryTypeLabels[entry.data.primaryType]??entry.data.primaryType}</dd></div><div><dt>子類型</dt><dd>{entry.data.subtypes.map(x=>subtypeLabels[x]??x).join('、')||'尚無資料'}</dd></div><div><dt>RTP</dt><dd>{entry.data.rtp?`${entry.data.rtp}%`:'尚無資料'}</dd></div><div><dt>波動度</dt><dd>{entry.data.volatility?volatilityLabels[entry.data.volatility]:'尚無資料'}</dd></div><div><dt>盤面</dt><dd>{entry.data.reels??'尚無資料'}</dd></div><div><dt>Paylines / Ways</dt><dd>{entry.data.paylines??'尚無資料'}</dd></div><div><dt>最後核對</dt><dd>{entry.data.source.checkedAt.toISOString().slice(0,10)}</dd></div></dl><section class="detail-copy"><h2>Bonus features</h2><p>{entry.data.bonusFeatures.length?entry.data.bonusFeatures.join('、'):'目前尚無已核對資料。'}</p>{related.length>0&&<><h2>相關遊戲</h2><div class="related-games">{related.map(item=><a href={gameUrl(item!.id)}><strong>{item!.data.displayNameZhHant??item!.data.originalName??item!.data.name}</strong>{item!.data.displayNameZhHant&&<small>{item!.data.originalName??item!.data.name}</small>}</a>)}</div></>}<h2>資料來源</h2><p><a href={entry.data.source.url} rel="nofollow">{entry.data.source.label} ↗</a></p>{entry.data.image&&<p class="media-credit"><a href={entry.data.image.sourceUrl} rel="nofollow">圖片來源 ↗</a> · 取得日期 {entry.data.image.retrievedAt.toISOString().slice(0,10)}</p>}</section></article></BaseLayout>
