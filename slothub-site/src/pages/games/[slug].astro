---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AddCompareButton from '../../components/AddCompareButton';
import { absoluteUrl, gameUrl, providerUrl } from '../../lib/urls';
import { featureLabels, jackpotTypeLabels, primaryTypeLabels, volatilityLabels, winMechanismLabels } from '../../lib/taxonomy';

export async function getStaticPaths() {
  const games = (await getCollection('games')).filter((game) => game.data.status === 'published');
  return games.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const providers = await getCollection('providers');
const allGames = (await getCollection('games')).filter((game) => game.data.status === 'published');
const provider = providers.find((item) => item.id === entry.data.provider);
const displayName = entry.data.displayNameZhHant ?? entry.data.originalName ?? entry.data.name;
const originalName = entry.data.originalName ?? entry.data.name;
const normalizedVolatility = entry.data.volatilityNormalized ?? entry.data.volatility;
const titleCharacters = Array.from(displayName);
const titlePrefix = titleCharacters.length > 4 ? titleCharacters.slice(0, -2).join('') : displayName;
const titleTail = titleCharacters.length > 4 ? titleCharacters.slice(-2).join('') : '';
const titleSizeClass = titleCharacters.length >= 16 ? 'is-very-long-title' : titleCharacters.length >= 10 ? 'is-long-title' : '';

const formatDate = (date: Date) => date.toISOString().slice(0, 10);
const formatMultiplier = (value: number) => `${value.toLocaleString('en-US')}×`;
const formatNumber = (value: number) => value.toLocaleString('zh-Hant-TW', { maximumFractionDigits: 8 });
const getMechanismLabel = () => {
  if (entry.data.winMechanism && entry.data.winMechanism !== 'other') {
    return winMechanismLabels[entry.data.winMechanism] ?? entry.data.winMechanism;
  }
  const detail = entry.data.paylines?.toLowerCase() ?? '';
  if (detail.includes('pay anywhere')) return winMechanismLabels['pay-anywhere'];
  if (detail.includes('scatter')) return '散佈賠付';
  if (detail.includes('ways')) return '多路贏法';
  return entry.data.winMechanism ? winMechanismLabels[entry.data.winMechanism] : undefined;
};
const mechanism = getMechanismLabel();
const gridDisplay = entry.data.reels
  ? entry.data.reels.replace(/\s*[x×]\s*/i, ' × ')
  : entry.data.rows ? `${entry.data.rows} 列` : undefined;
const winCountDisplay = entry.data.winCount
  ? entry.data.winMechanism === 'paylines'
    ? `${entry.data.winCount.toLocaleString()} 條賠線`
    : entry.data.winMechanism === 'ways-to-win' || entry.data.winMechanism === 'megaways'
      ? `${entry.data.winCount.toLocaleString()} 路`
      : entry.data.winCount.toLocaleString()
  : undefined;

const explicitRelated = entry.data.relatedGames
  .map((slug) => allGames.find((game) => game.id === slug))
  .filter(Boolean);
const sameSeries = entry.data.seriesId
  ? allGames.filter((game) => game.id !== entry.id && game.data.seriesId === entry.data.seriesId)
  : [];
const seriesGames = [...explicitRelated, ...sameSeries]
  .filter((game, index, games) => game && games.findIndex((item) => item?.id === game.id) === index);
const seriesSlugs = new Set(seriesGames.map((game) => game!.id));
const providerGames = allGames
  .filter((game) => game.id !== entry.id && game.data.provider === entry.data.provider && !seriesSlugs.has(game.id))
  .sort((a, b) => {
    const aName = a.data.displayNameZhHant ?? a.data.originalName ?? a.data.name;
    const bName = b.data.displayNameZhHant ?? b.data.originalName ?? b.data.name;
    return aName.localeCompare(bName, 'zh-Hant-TW');
  })
  .slice(0, 4);

const coreStats = [
  entry.data.rtp !== undefined ? { label: '主要 RTP', value: `${entry.data.rtp}%`, badge: entry.data.rtpVariants.length > 1 ? '多版本' : undefined } : undefined,
  normalizedVolatility ? { label: '統一波動度', value: volatilityLabels[normalizedVolatility] ?? normalizedVolatility } : undefined,
  entry.data.maxWinMultiplier !== undefined ? { label: '最高倍數', value: formatMultiplier(entry.data.maxWinMultiplier) } : undefined,
  mechanism ? { label: '賠付機制', value: mechanism } : undefined,
].filter(Boolean) as { label: string; value: string; badge?: string }[];

const fullSpecs = [
  entry.data.rtpVariants.length ? { label: '所有 RTP 版本', value: entry.data.rtpVariants.map((value) => `${value}%`).join('、') } : undefined,
  entry.data.volatilityOriginal ? { label: '原廠波動度', value: entry.data.volatilityOriginal } : undefined,
  normalizedVolatility ? { label: 'Slot Hub 統一波動度', value: volatilityLabels[normalizedVolatility] ?? normalizedVolatility } : undefined,
  gridDisplay ? { label: '盤面', value: gridDisplay } : undefined,
  winCountDisplay ? { label: '賠線／Ways 數量', value: winCountDisplay } : undefined,
  entry.data.maxWinMultiplier !== undefined ? { label: '最高倍數', value: formatMultiplier(entry.data.maxWinMultiplier), note: entry.data.maxWinLabelOriginal ? `原廠標示：${entry.data.maxWinLabelOriginal}` : undefined } : undefined,
  entry.data.bonusBuy !== undefined ? { label: 'Bonus Buy', value: entry.data.bonusBuy ? '支援' : '不支援' } : undefined,
  entry.data.jackpotType ? { label: 'Jackpot 類型', value: jackpotTypeLabels[entry.data.jackpotType] ?? entry.data.jackpotType } : undefined,
  entry.data.minBet !== undefined ? { label: '最低投注', value: formatNumber(entry.data.minBet) } : undefined,
  entry.data.maxBet !== undefined ? { label: '最高投注', value: formatNumber(entry.data.maxBet) } : undefined,
  entry.data.releaseDate ? { label: '發行日期', value: formatDate(entry.data.releaseDate) } : undefined,
  entry.data.gameId ? { label: 'Game ID', value: entry.data.gameId } : undefined,
].filter(Boolean) as { label: string; value: string; note?: string }[];

const sources = entry.data.sources.length ? entry.data.sources : [entry.data.source];
const game = {
  slug: entry.id, name: displayName, originalName, displayNameZhHant: entry.data.displayNameZhHant,
  aliases: entry.data.aliases, seriesId: entry.data.seriesId, seriesNameZhHant: entry.data.seriesNameZhHant,
  installment: entry.data.installment, relatedGames: entry.data.relatedGames, provider: entry.data.provider,
  providerName: provider?.data.name ?? entry.data.provider, primaryType: entry.data.primaryType,
  subtypes: entry.data.subtypes, summary: entry.data.summary,
  image: entry.data.image ? { src: entry.data.image.src, alt: entry.data.image.alt } : undefined,
  rtp: entry.data.rtp, rtpVariants: entry.data.rtpVariants, volatility: normalizedVolatility,
  maxWinMultiplier: entry.data.maxWinMultiplier, winMechanism: entry.data.winMechanism,
  reels: entry.data.reels, paylines: entry.data.paylines, bonusFeatures: entry.data.bonusFeatures,
  editorialFeatured: entry.data.editorialFeatured, url: gameUrl(entry.id),
};
const schema = {
  '@context': 'https://schema.org', '@type': 'VideoGame', name: displayName,
  alternateName: displayName !== originalName ? originalName : undefined,
  description: entry.data.summary, url: absoluteUrl(gameUrl(entry.id)),
  image: entry.data.image ? absoluteUrl(entry.data.image.src) : undefined,
  publisher: provider ? { '@type': 'Organization', name: provider.data.name, url: provider.data.officialUrl } : undefined,
  gamePlatform: 'Web', inLanguage: 'zh-Hant-TW',
  datePublished: entry.data.releaseDate ? formatDate(entry.data.releaseDate) : undefined,
  dateModified: formatDate(entry.data.updatedAt),
};
---

<BaseLayout title={`${displayName}｜遊戲資料｜Slot Hub`} description={entry.data.summary} canonicalPath={gameUrl(entry.id)} schema={schema}>
  <article class="game-file-page shell">
    <a class="back-link game-file-back" href="/games/">← 返回遊戲庫</a>

    <header class="game-file-hero">
      <figure class="game-file-art">
        {entry.data.image ? <img src={entry.data.image.src} alt={entry.data.image.alt} /> : <div aria-hidden="true">{displayName.slice(0, 1)}</div>}
        <figcaption>{primaryTypeLabels[entry.data.primaryType] ?? entry.data.primaryType}</figcaption>
      </figure>
      <div class="game-file-identity">
        <p class="eyebrow">GAME FILE / {entry.id}</p>
        <h1 class={titleSizeClass}>{titlePrefix}{titleTail && <span class="game-title-tail">{titleTail}</span>}</h1>
        {entry.data.displayNameZhHant && <p class="game-file-original">{originalName}</p>}
        <div class="game-file-meta">
          {provider && <a href={providerUrl(entry.data.provider)}>{provider.data.name} ↗</a>}
          {entry.data.seriesNameZhHant && <span>{entry.data.seriesNameZhHant}{entry.data.installment ? ` · 第 ${entry.data.installment} 代` : ''}</span>}
        </div>
        <p class="game-file-summary">{entry.data.summary}</p>
        <div class="action-row">
          <AddCompareButton game={game} allSlugs={allGames.map((item) => item.id)} client:load />
          <a class="button secondary" href="/compare/">查看比較頁</a>
        </div>
      </div>
    </header>

    {coreStats.length > 0 && <section class="game-core-stats" aria-labelledby="core-data-title">
      <h2 id="core-data-title">核心數據</h2>
      <dl>{coreStats.map((stat) => <div><dt>{stat.label}</dt><dd>{stat.value}{stat.badge && <small>{stat.badge}</small>}</dd></div>)}</dl>
    </section>}

    {(fullSpecs.length > 0 || entry.data.features.length > 0) && <section class="game-data-section" aria-labelledby="full-data-title">
      <div class="game-section-heading"><p class="eyebrow">STRUCTURED DATA</p><h2 id="full-data-title">完整遊戲資料</h2></div>
      {fullSpecs.length > 0 && <dl class="game-spec-grid">{fullSpecs.map((spec) => <div><dt>{spec.label}</dt><dd>{spec.value}</dd>{spec.note && <small>{spec.note}</small>}</div>)}</dl>}
      {entry.data.features.length > 0 && <div class="game-features"><h3>遊戲功能</h3><ul>{entry.data.features.map((feature) => <li>{featureLabels[feature] ?? feature}</li>)}</ul></div>}
    </section>}

    {(seriesGames.length > 0 || providerGames.length > 0) && <section class="game-relations" aria-labelledby="related-title">
      <div class="game-section-heading"><p class="eyebrow">RELATED GAMES</p><h2 id="related-title">關聯遊戲</h2></div>
      {seriesGames.length > 0 && <div class="relation-group"><h3>同系列遊戲</h3><div class="related-game-grid">
        {seriesGames.map((item) => item && <a href={gameUrl(item.id)}>{item.data.image && <img src={item.data.image.src} alt="" loading="lazy" />}<span><strong>{item.data.displayNameZhHant ?? item.data.originalName ?? item.data.name}</strong>{item.data.displayNameZhHant && <small>{item.data.originalName ?? item.data.name}</small>}</span>{item.data.installment && <b>第 {item.data.installment} 代</b>}</a>)}
      </div></div>}
      {providerGames.length > 0 && <div class="relation-group"><h3>同廠商遊戲</h3><div class="related-game-grid">
        {providerGames.map((item) => <a href={gameUrl(item.id)}>{item.data.image && <img src={item.data.image.src} alt="" loading="lazy" />}<span><strong>{item.data.displayNameZhHant ?? item.data.originalName ?? item.data.name}</strong>{item.data.displayNameZhHant && <small>{item.data.originalName ?? item.data.name}</small>}</span></a>)}
      </div></div>}
    </section>}

    {(sources.length > 0 || entry.data.lastVerifiedAt || entry.data.image) && <section class="game-sources" aria-labelledby="source-title">
      <div><p class="eyebrow">DATA NOTES</p><h2 id="source-title">資料資訊</h2>{entry.data.lastVerifiedAt && <p>最後核對日期 <strong>{formatDate(entry.data.lastVerifiedAt)}</strong></p>}</div>
      <ul>
        {sources.map((source) => <li><a href={source.url} rel="nofollow">{source.label} ↗</a><small>核對 {formatDate(source.checkedAt)}</small></li>)}
        {entry.data.image && <li><a href={entry.data.image.sourceUrl} rel="nofollow">圖片來源 ↗</a><small>取得 {formatDate(entry.data.image.retrievedAt)}</small></li>}
      </ul>
    </section>}
  </article>
</BaseLayout>
