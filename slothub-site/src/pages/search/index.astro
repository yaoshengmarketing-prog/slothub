---
import {getCollection} from 'astro:content';import BaseLayout from '../../layouts/BaseLayout.astro';import SearchHub from '../../components/SearchHub';import {gameUrl,providerUrl,guideUrl} from '../../lib/urls';const games=(await getCollection('games')).filter(g=>g.data.status==='published');const providers=(await getCollection('providers')).filter(p=>p.data.status==='published');const guides=(await getCollection('guides')).filter(g=>g.data.status==='published');const names=new Map(providers.map(p=>[p.id,p.data.name]));const items=[...games.map(g=>({slug:g.id,title:g.data.displayNameZhHant??g.data.originalName??g.data.name,secondaryTitle:g.data.displayNameZhHant?(g.data.originalName??g.data.name):undefined,description:g.data.summary,kind:'遊戲' as const,url:gameUrl(g.id),aliases:g.data.aliases,providerName:names.get(g.data.provider)??g.data.provider,seriesName:g.data.seriesNameZhHant,installment:g.data.installment,searchText:[g.data.summary]})),...providers.map(p=>({slug:p.id,title:p.data.name,description:p.data.summary,kind:'廠商' as const,url:providerUrl(p.id),aliases:p.data.aliases,searchText:[p.data.brandName??'',p.data.summary]})),...guides.map(g=>({slug:g.id,title:g.data.title,description:g.data.description,kind:'教學' as const,url:guideUrl(g.id),aliases:g.data.tags,searchText:[g.data.description]}))];
---
<BaseLayout title="搜尋｜Slot Hub" description="搜尋 Slot Hub 的遊戲、廠商與教學內容。" canonicalPath="/search/" robots="noindex,follow"><section class="page-hero shell"><p class="eyebrow">SEARCH</p><h1>搜尋 Slot Hub</h1><p>目前索引涵蓋遊戲、遊戲廠商及教學內容。</p></section><section class="search-page shell"><SearchHub items={items} client:load/></section></BaseLayout>
