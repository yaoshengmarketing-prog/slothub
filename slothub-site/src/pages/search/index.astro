---
import {getCollection} from 'astro:content';import BaseLayout from '../../layouts/BaseLayout.astro';import SearchHub from '../../components/SearchHub';import {gameUrl,providerUrl,guideUrl} from '../../lib/urls';const games=await getCollection('games');const providers=await getCollection('providers');const guides=await getCollection('guides');const names=new Map(providers.map(p=>[p.id,p.data.name]));const items=[...games.map(g=>({slug:g.id,title:g.data.name,description:`${names.get(g.data.provider)} · ${g.data.summary}`,kind:'遊戲' as const,url:gameUrl(g.id)})),...providers.map(p=>({slug:p.id,title:p.data.name,description:p.data.summary,kind:'廠商' as const,url:providerUrl(p.id)})),...guides.map(g=>({slug:g.id,title:g.data.title,description:g.data.description,kind:'教學' as const,url:guideUrl(g.id)}))];
---
<BaseLayout title="搜尋｜Slot Hub" description="搜尋 Slot Hub 的遊戲、廠商與教學內容。" canonicalPath="/search/" robots="noindex,follow"><section class="page-hero shell"><p class="eyebrow">SEARCH</p><h1>搜尋 Slot Hub</h1><p>目前索引涵蓋遊戲、遊戲廠商及教學內容。</p></section><section class="search-page shell"><SearchHub items={items} client:load/></section></BaseLayout>
