---
import {getCollection} from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SearchHub from '../../components/SearchHub';
import {loadPublishedGameCatalog} from '../../lib/game-catalog';
import {buildPublishedSearchCatalog} from '../../lib/search-catalog';
import {createGuideRelationshipIndex,relationshipSearchItems} from '../../lib/guide-relationship-catalog';
const {games,providers}=await loadPublishedGameCatalog();
const guides=(await getCollection('guides')).filter(g=>g.data.status==='published');
const relationships=createGuideRelationshipIndex(guides,games);
const items=buildPublishedSearchCatalog(games,providers,guides,relationshipSearchItems(relationships));
---
<BaseLayout title="搜尋｜Slot Hub" description="搜尋 Slot Hub 的遊戲、廠商與教學內容。" canonicalPath="/search/" robots="noindex,follow">
  <section class="search-v3-stage shell">
    <header><p class="eyebrow">SEARCH</p><h1>用文字線索找遊戲</h1><p>輸入遊戲名稱、原文名稱、別名、遊戲廠商或概念。結果會分清遊戲、廠商以及教學入口。</p></header>
    <div class="search-page-v3"><SearchHub items={items} urlState client:load/></div>
  </section>
</BaseLayout>
