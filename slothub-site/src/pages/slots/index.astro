---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { gamesIndexUrl } from '../../lib/urls';
import { filterAndSortGames, emptyExplorerState } from '../../lib/game-explorer-state.mjs';
import { loadPublishedGameCatalog } from '../../lib/game-catalog';
import { createGuideRelationshipIndex, conceptExplorerUrl, relationshipLabel } from '../../lib/guide-relationship-catalog';
import { buildGuideReadingSections, GUIDE_READING_PATHS } from '../../lib/guide-reading-path.mjs';
import CascadingDemo from '../../components/CascadingDemo.astro';
import PayoutMechanismDemo from '../../components/PayoutMechanismDemo.astro';

const catalog = await loadPublishedGameCatalog();
const games = catalog.games.filter((game) => game.primaryType === 'slots');
const guides = (await getCollection('guides')).filter((entry) => entry.data.status === 'published');
const relationships = createGuideRelationshipIndex(guides, catalog.games);
const readingPaths = buildGuideReadingSections(guides, GUIDE_READING_PATHS);

const conceptCount = (type: 'mechanism' | 'feature', value: string) => filterAndSortGames(games, {
  ...emptyExplorerState(),
  ...(type === 'mechanism' ? { mechanism: value } : { features: [value] }),
}).length;

const mechanismDefinitions = [
  { value: 'paylines', summary: '依指定路線上的符號判定。賠線可以是直線，也可以跨列，依各款規則而定。' },
  { value: 'ways-to-win', summary: '通常檢查相鄰轉軸上的有效符號，符號可以在不同列，不必排在同一條賠線。' },
  { value: 'megaways', summary: '各軸的可見符號位置數可以變動，可能成立的贏法數也會隨盤面改變。' },
  { value: 'cluster-pays', summary: '以相鄰符號群集是否達成條件判定。' },
  { value: 'pay-anywhere', summary: '依個別規則核對符號數量與位置要求。' },
] as const;

const mechanismConcepts = mechanismDefinitions.flatMap((definition) => {
  const guide = relationships.mechanismToGuides[definition.value]?.[0];
  const exploreHref = conceptExplorerUrl('mechanism', definition.value);
  return guide && exploreHref ? [{
    ...definition,
    label: relationshipLabel('mechanism', definition.value),
    guide,
    exploreHref,
    count: conceptCount('mechanism', definition.value),
  }] : [];
});

const featureDefinitions = [
  { title: 'Symbols 與 Feature 角色', values: ['wild', 'scatter', 'free-spins', 'jackpot'] },
  { title: 'Multiplier 倍數功能', values: ['multiplier'] },
  { title: 'Cascading 連鎖消除', values: ['cascading'] },
  { title: 'Bonus Buy 功能購買', values: ['bonus-buy'] },
] as const;

const featureGroups = featureDefinitions.flatMap((definition) => {
  const guide = relationships.featureToGuides[definition.values[0]]?.[0];
  if (!guide) return [];
  const concepts = definition.values.flatMap((value) => {
    const exploreHref = conceptExplorerUrl('feature', value);
    return exploreHref ? [{
      value,
      label: relationshipLabel('feature', value),
      exploreHref,
      count: conceptCount('feature', value),
    }] : [];
  });
  return [{ ...definition, guide, concepts }];
});

const dataTopicDefinitions = [
  { value: 'rtp', title: 'RTP 與多版本', summary: '指定版本在大量遊戲下的理論回報比例。同款可能有不同設定，請以實際版本的遊戲資訊為準。' },
  { value: 'volatility', title: '波動度', summary: '描述派彩結果的分布與起伏。各廠商的標示尺度可能不同，比較前先看原廠怎麼定義。' },
  { value: 'max-win', title: '最高倍數', summary: '在指定投注基準、範圍與規則下的派彩上限。想知道這個數字怎麼讀，先確認它涵蓋整局或單一功能。' },
] as const;

const dataTopics = dataTopicDefinitions.flatMap((definition) => {
  const guide = relationships.dataTopicToGuides[definition.value]?.[0];
  return guide ? [{ ...definition, guide }] : [];
});
---
<BaseLayout title="老虎機玩法與遊戲資料｜RTP、波動度與功能｜Slot Hub" description="認識老虎機的賠付方式、功能與遊戲規則，了解 RTP、波動度及版本資訊。從教學與遊戲實例出發，查閱已收錄資料與來源，理解不同遊戲的差異。" canonicalPath="/slots/">
  <section class="slots-v3-hero">
    <div class="shell">
      <div>
        <p class="eyebrow">PLAY &amp; DATA HUB</p>
        <h1><span class="keep">老虎機</span><span class="keep">玩法與遊戲數據</span></h1>
        <p>老虎機（Slot）通常在轉輪停下後，依遊戲規則判定畫面上的符號組合是否得獎。想看懂一局怎麼判定，先找遊戲內的賠付表（Paytable）或規則說明，確認哪些位置會計入，再看百搭符號、免費旋轉等功能何時生效。</p>
        <div class="slots-v3-actions">
          <a class="button primary" href={gamesIndexUrl({ primaryType: 'slots' })}>前往 {games.length} 款老虎機</a>
          <a class="button secondary" href="/guide/slot-beginners-guide/">老虎機新手入門</a>
        </div>
      </div>
      <aside aria-label="玩法與資料入口摘要">
        <strong>{games.length}</strong><span>款老虎機資料</span>
        <strong>{mechanismConcepts.length}</strong><span>種主要賠付方式</span>
        <strong>{featureGroups.reduce((total, group) => total + group.concepts.length, 0)}</strong><span>項已有教學承接的功能</span>
      </aside>
    </div>
    <nav class="slots-v3-jump shell" aria-label="玩法與資料分類">
      <a href="#mechanisms">看懂賠付方式</a>
      <a href="#features">看懂遊戲功能</a>
      <a href="#data-topics">看懂核心資料</a>
    </nav>
  </section>

  <section class="slots-hub-section slots-types shell" aria-labelledby="slots-types-title">
    <header class="slots-hub-heading">
      <div><p class="eyebrow">REELS &amp; ROWS</p><h2 id="slots-types-title">老虎機種類與盤面差異</h2></div>
      <p>經典三軸常見水果、BAR 或七字等符號，視訊老虎機則可以用多軸、方格或會變動的盤面。以 5 × 3 為例，畫面有五個直向轉軸，每軸顯示三個位置。</p>
    </header>
    <p>經典風格也可以有五軸。例如 <a href="/games/100-happy-seven/">100 Happy Seven</a> 採用經典符號，盤面是 5 × 3，依 100 條賠線判定。<a href="/games/reactoonz/">Reactoonz</a> 則用 7 × 7 方格，依相鄰符號的群集判定。辨認畫面後，還要看哪些位置和組合符合得獎條件。</p>
  </section>

  <section class="slots-hub-section shell" id="mechanisms" aria-labelledby="mechanisms-title">
    <header class="slots-hub-heading">
      <div><p class="eyebrow">HOW WINS FORM</p><h2 id="mechanisms-title">先分清主要賠付方式</h2></div>
      <p>同樣出現三個相同符號，位置不同就可能得到不同判定。用下方的<a href="#payout-mechanism-demo">賠線與 Ways 圖解</a>切換同一盤面，看看兩種規則各檢查哪些位置。想知道遊戲內的賠付表在哪裡，可先讀<a href="/guide/slot-screen-beginners-guide/">老虎機畫面入門</a>。</p>
    </header>
    <div class="slots-mechanism-grid">
      {mechanismConcepts.map((item, index) => <article>
        <span>{String(index + 1).padStart(2, '0')} / {item.count} 款</span>
        <h3>{item.label}</h3>
        <p>{item.summary}</p>
        <div><a href={item.exploreHref}>查看 {item.count} 款遊戲</a><a href={item.guide.url}>看懂賠付機制</a></div>
      </article>)}
    </div>
    <PayoutMechanismDemo />
  </section>

  <section class="slots-hub-section slots-hub-section-soft" id="features" aria-labelledby="features-title">
    <div class="shell">
      <header class="slots-hub-heading">
        <div><p class="eyebrow">FEATURES</p><h2 id="features-title">再看功能如何改變過程</h2></div>
        <p>功能描述遊戲過程中還會發生什麼。Wild（百搭）可以依規則替代部分符號，Free Spins（免費旋轉）需要符合觸發條件，Multiplier（倍數）則要看它乘在哪一筆派彩。</p>
      </header>
      <div class="knowledge-grid relationship-knowledge-grid slots-feature-grid">
        {featureGroups.map((group) => <article>
          <strong>{group.title}</strong>
          <span>{group.guide.description}</span>
          <ul aria-label={`${group.title}可探索功能`}>{group.concepts.map((concept) => <li><a href={concept.exploreHref}>{concept.label}<small>{concept.count} 款</small></a></li>)}</ul>
          <div><a href={group.guide.url}>了解概念 →</a></div>
        </article>)}
      </div>
      <CascadingDemo />
    </div>
  </section>

  <section class="slots-hub-section shell" id="data-topics" aria-labelledby="data-topics-title">
    <header class="slots-hub-heading">
      <div><p class="eyebrow">DATA TOPICS</p><h2 id="data-topics-title">資料數字要連同基準一起讀</h2></div>
      <p>RTP、波動度與最高倍數回答不同問題。它們不是短期結果預測，也不能只看數字大小就排出哪款比較容易贏。</p>
    </header>
    <div class="slots-data-grid">
      {dataTopics.map((item) => <article>
        <strong>{item.title}</strong>
        <p>{item.summary}</p>
        <a href={item.guide.url}>了解{item.title} →</a>
      </article>)}
    </div>
    <aside class="slots-method-note">
      <div><strong>資料從哪裡來？</strong><p>查看 Slot Hub 如何保留原廠文字、處理缺值、多版本與核對日期。</p></div>
      <a href="/guide/slot-hub-data-methodology/">資料方法與可信度 →</a>
    </aside>
  </section>

  <section class="slots-hub-section slots-reading-section shell">
    <header class="slots-hub-heading"><div><p class="eyebrow">GUIDE READING PATH</p><h2>需要完整脈絡時，依問題繼續讀</h2></div><p>六段閱讀路線與 Guide 總覽使用相同順序；也可以直接進入任何一篇需要的教學。</p></header>
    <div class="guide-route-grid" data-guide-reading-summary="slots">{readingPaths.map((path) => <a class="guide-route-card" href={path.href} data-guide-reading-route={path.id}><span>{path.index} / {path.eyebrow}</span><strong>{path.title}</strong><p>{path.description}</p><b>{path.guides.length} 篇 Guide →</b></a>)}</div>
  </section>
</BaseLayout>

<style>
  .slots-types { padding-block: 48px 0; }
  .slots-types .slots-hub-heading { margin-bottom: 16px; }
  .slots-types > p { max-width: 70ch; margin: 0; color: var(--muted); line-height: 1.75; }
  .slots-types a, .slots-hub-heading a { color: var(--navy); text-underline-offset: .18em; }
</style>
