---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameExplorer from '../../components/GameExplorer';
import { gamesIndexUrl, guideUrl, providerUrl } from '../../lib/urls';
import { filterAndSortGames, emptyExplorerState } from '../../lib/game-explorer-state.mjs';
import { loadPublishedGameCatalog } from '../../lib/game-catalog';
import { subtypeLabels } from '../../lib/taxonomy';
import { createGuideRelationshipIndex, conceptExplorerUrl, explorerGuideLinks, relationshipLabel } from '../../lib/guide-relationship-catalog';
const catalog = await loadPublishedGameCatalog();
const providers = catalog.providers;
const games = catalog.games.filter((game) => game.primaryType === 'slots');
const subtypeCounts = [...new Set(games.flatMap((game) => game.subtypes))].map((type) => ({
  type,
  count: filterAndSortGames(games, { ...emptyExplorerState(), primaryType: 'slots', subtype: type }).length,
  href: gamesIndexUrl({ primaryType: 'slots', subtype: type }),
}));
const guides = (await getCollection('guides')).filter((entry) => entry.data.status === 'published');
const relationships = createGuideRelationshipIndex(guides, catalog.games);
const relationshipLinks = explorerGuideLinks(relationships);
const knowledgeConcepts = [
  { type: 'data-topic', value: 'rtp' }, { type: 'data-topic', value: 'volatility' },
  { type: 'mechanism', value: 'paylines' }, { type: 'mechanism', value: 'ways-to-win' },
  { type: 'feature', value: 'wild' }, { type: 'feature', value: 'scatter' },
  { type: 'feature', value: 'free-spins' }, { type: 'feature', value: 'jackpot' },
  { type: 'feature', value: 'cascading' }, { type: 'feature', value: 'bonus-buy' },
] as const;
const lookup = { mechanism: relationships.mechanismToGuides, feature: relationships.featureToGuides, 'data-topic': relationships.dataTopicToGuides };
const knowledge = knowledgeConcepts.flatMap(({ type, value }) => {
  const guide = lookup[type][value]?.[0];
  return guide ? [{ label: relationshipLabel(type, value), text: guide.description, guideHref: guide.url, exploreHref: conceptExplorerUrl(type, value) }] : [];
});
---
<BaseLayout title="老虎機遊戲探索｜Slot Hub" description="依廠商、子類型、RTP 與波動度探索老虎機，閱讀常見機制與新手教學。" canonicalPath="/slots/">
  <section class="page-hero shell"><p class="eyebrow">SLOT HUB</p><h1>老虎機</h1><p>從遊戲本身開始：查廠商、看資料、比較機制，再用教學理解欄位。</p></section>
  <section class="section shell"><div class="section-head"><div><p class="eyebrow">EXPLORE</p><h2>探索老虎機</h2></div><p>依目前有可靠資料的條件篩選；底層分類代碼不會顯示給使用者。</p></div><GameExplorer games={games} relationshipLinks={relationshipLinks} handoffDefaults={{ primaryType: 'slots' }} initialLimit={8} client:load /></section>
  <section class="hub-band"><div class="shell"><div class="section-head"><div><p class="eyebrow">SUBTYPES</p><h2>從玩法結構開始找</h2></div><p>同一款遊戲可以同時具有多個子類型，個別網址仍固定在 <code>/games/&#123;slug&#125;/</code>。</p></div><div class="topic-grid">{subtypeCounts.map((item) => <a href={item.href}><strong>{subtypeLabels[item.type] ?? item.type}</strong><span>{item.count} 款目前資料</span><b>套用條件探索 →</b></a>)}</div></div></section>
  <section class="section shell"><div class="section-head"><div><p class="eyebrow">KNOWLEDGE MAP</p><h2>先看懂常見資料</h2></div><p>只顯示已有正式教學承接的概念；探索入口會保留目前資料條件。</p></div><div class="knowledge-grid relationship-knowledge-grid">{knowledge.map((item) => <article><strong>{item.label}</strong><span>{item.text}</span><div><a href={item.guideHref}>了解概念 →</a>{item.exploreHref && <a href={item.exploreHref}>探索遊戲 →</a>}</div></article>)}</div></section>
  <section class="dark-section"><div class="shell"><div class="section-head light"><div><p class="eyebrow">EDITOR'S SELECTION</p><h2>編輯精選遊戲</h2></div><p>依資料完整度與探索測試需求選擇，不代表熱門排行。</p></div><div class="feature-strip">{games.filter((game) => game.editorialFeatured).slice(0, 5).map((game, index) => <a href={game.url}><span>0{index + 1}</span><div><small>{game.providerName}</small><strong>{game.name}</strong></div><b>{game.rtp ? `${game.rtp}% RTP` : '資料整理中'} →</b></a>)}</div></div></section>
  <section class="section providers-band shell"><div><p class="eyebrow">SLOT PROVIDERS</p><h2>目前收錄廠商</h2></div><div class="provider-chips">{providers.filter((provider) => games.some((game) => game.provider === provider.id)).map((provider) => <a href={providerUrl(provider.id)}>{provider.data.logo ? <span class="provider-logo"><img src={provider.data.logo.src} alt={provider.data.logo.alt} loading="lazy" /></span> : <span>{provider.data.name.slice(0, 2)}</span>}<strong>{provider.data.name}</strong><small>{games.filter((game) => game.provider === provider.id).length} 款資料</small></a>)}</div></section>
  <section class="section shell"><div class="section-head"><div><p class="eyebrow">START HERE</p><h2>新手閱讀路線</h2></div><p>先理解基本欄位，再回到探索器實際操作。</p></div><div class="guide-list">{guides.filter((guide) => ['beginner', 'data', 'mechanics'].includes(guide.data.category)).slice(0, 5).map((guide, index) => <a href={guideUrl(guide.id)}><span>0{index + 1}</span><div><strong>{guide.data.title}</strong><p>{guide.data.description}</p></div><b>閱讀 →</b></a>)}</div></section>
</BaseLayout>
