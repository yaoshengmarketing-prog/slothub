---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchHub from '../components/SearchHub';
import { loadPublishedGameCatalog } from '../lib/game-catalog';
import { buildPublishedSearchCatalog } from '../lib/search-catalog';
import { createGuideRelationshipIndex, relationshipSearchItems } from '../lib/guide-relationship-catalog';
const { games, providers: providerEntries } = await loadPublishedGameCatalog();
const guides=(await getCollection('guides')).filter(x=>x.data.status==='published');
const relationships=createGuideRelationshipIndex(guides,games);
const searchItems=buildPublishedSearchCatalog(games,providerEntries,guides,relationshipSearchItems(relationships));
const intentRoutes = [
  { index: '01', title: '我知道遊戲名稱', description: '搜尋繁中名稱、原文名稱、別名或廠商。', href: '/search/', action: '開啟搜尋' },
  { index: '02', title: '我只記得遊戲廠商', description: '從 39 家已收錄廠商找到旗下遊戲。', href: '/providers/', action: '查看遊戲廠商' },
  { index: '03', title: '我記得功能或玩法', description: '先分清玩法、Feature 與資料，再用條件探索。', href: '/slots/', action: '理解玩法與資料' },
  { index: '04', title: '我想找類似玩法', description: '先選一款參考遊戲，再查看有明確共同點的玩法相近項目。', href: '/games/', action: '先選一款遊戲' },
] as const;
const schema={'@context':'https://schema.org','@type':'WebSite',name:'Slot Hub',url:'https://www.slothub.com.tw/',inLanguage:'zh-Hant-TW'};
---
<BaseLayout title="Slot Hub｜老虎機遊戲資料、搜尋與比較" description="搜尋老虎機與遊戲廠商，依 RTP、波動度及類型探索遊戲，最多比較三款遊戲。" schema={schema}>
  <section class="home-v3-stage shell">
    <div class="hero-kicker"><span>GAME DATA / KNOWLEDGE / DISCOVERY</span><i>資料持續核對</i></div>
    <div class="home-v3-head">
      <div class="home-v3-copy"><p class="eyebrow">SLOT HUB</p><h1>用你記得的線索，<br/><em>找到並看懂<span class="keep">遊戲。</span></em></h1><p>搜尋名稱、從廠商開始，或先看懂某個玩法。Slot Hub 會保留來源、版本與未知欄位，不用排行榜替你猜答案。</p></div>
      <div class="home-v3-search" id="home-search"><SearchHub items={searchItems} compact client:load/><dl class="home-v3-counts"><div><dt>遊戲</dt><dd>{games.length}</dd></div><div><dt>廠商</dt><dd>{providerEntries.length}</dd></div><div><dt>教學</dt><dd>{guides.length}</dd></div></dl></div>
    </div>
  </section>

  <section class="home-v3-routes shell" aria-labelledby="home-routes-title"><div class="home-v3-route-head"><div><p class="eyebrow">CHOOSE A START</p><h2 id="home-routes-title">你現在記得什麼？</h2></div><p>四條路都會回到同一份遊戲與來源資料，你可以隨時換一種找法。</p></div><ol>{intentRoutes.map((route)=><li><span>{route.index}</span><div><h3>{route.title}</h3><p>{route.description}</p></div><a href={route.href} data-home-intent-route={route.index}>{route.action} →</a></li>)}</ol></section>

  <section class="home-v3-first"><div class="shell"><div><p class="eyebrow">FIRST VISIT</p><h2>第一次使用？先學會讀一款遊戲。</h2><p>從身份、RTP、波動度、最高倍數、玩法、缺值到來源，依序看懂 Game detail。</p></div><a class="button secondary" href="/guide/slot-beginners-guide/" data-home-beginner-guide>閱讀新手指南 →</a></div></section>

  <section class="home-v3-proof shell" aria-labelledby="home-proof-title"><div><p class="eyebrow">WHY SLOT HUB</p><h2 id="home-proof-title">資料有邊界，才值得比較。</h2></div><article><h3>保留原廠來源</h3><p>具名數字與功能回到來源，不用搜尋摘要補成事實。</p></article><article><h3>版本不混成單一值</h3><p>多個 RTP 與原廠標籤保留差異，不平均、不補猜。</p></article><article><h3>缺值就是未知</h3><p>尚未核實不等於 0、不支援或功能不存在。</p></article></section>
</BaseLayout>
