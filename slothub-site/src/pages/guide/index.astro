---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { guideUrl } from '../../lib/urls';
import { buildGuideReadingSections, GUIDE_READING_EXTENSIONS, GUIDE_READING_PATHS } from '../../lib/guide-reading-path.mjs';
const guides = (await getCollection('guides')).filter((entry) => entry.data.status === 'published');
const readingPaths = buildGuideReadingSections(guides, GUIDE_READING_PATHS);
const extensions = buildGuideReadingSections(guides, GUIDE_READING_EXTENSIONS);
const sections = [...readingPaths, ...extensions];
---
<BaseLayout title="教學與知識｜Slot Hub" description="依新手入門、遊戲機制、數據概念、Slot 術語及捕魚機教學閱讀內容。" canonicalPath="/guide/">
  <section class="page-hero shell"><p class="eyebrow">GUIDE LIBRARY</p><h1>教學與知識</h1><p>依問題選擇閱讀路線；順序只是建議，你可以自由往返任何文章與工具。</p></section>
  <nav class="guide-topics shell" aria-label="Guide 閱讀路線">{sections.map((section) => <a href={`#route-${section.id}`}><span>{section.guides.length}</span>{section.title}</a>)}</nav>
  <div class="shell guide-sections" data-guide-reading-library>{sections.map((section) => <section id={`route-${section.id}`} data-guide-reading-section={section.id}><div class="guide-section-head"><p class="eyebrow">{section.index} / {section.eyebrow}</p><h2>{section.title}</h2><span>{section.guides.length} 篇</span><p>{section.description}</p></div><div class="guide-list">{section.guides.map((guide, index) => <a href={guideUrl(guide.id)} data-guide-reading-slug={guide.id}><span>{section.index}.{index + 1}</span><div><strong>{guide.data.title}</strong><p>{guide.data.description}</p></div><b>閱讀 →</b></a>)}</div></section>)}</div>
</BaseLayout>
