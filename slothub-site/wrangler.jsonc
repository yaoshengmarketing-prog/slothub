{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "slothub",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-08-28",
  "vars": {
    "PUBLIC_SITE_ENV": "production"
  },
  "env": {
    "preview": {
      "vars": {
        "PUBLIC_SITE_ENV": "preview"
      }
    }
  }
}
